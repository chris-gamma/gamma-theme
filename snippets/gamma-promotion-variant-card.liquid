{%- doc -%}
  Renders a campaign card for a variant-limited group: the product's eligible variant, linked directly,
  with that variant's image and price, laid out like the theme's product card as the campaign template
  configures it. It has no Quick Add, because the native card would add the product's default variant,
  which may not qualify. The badges are the theme's own and describe the linked variant: sold out or
  sale, then Gamma's backorder or special-order badge when those are enabled.

  @param {object} variant - The eligible variant the card links to (the first listed one of its product).
  @param {string} names - Comma-separated titles of the product's eligible variants.
  @param {number} [count] - How many eligible variants `names` holds. Defaults to 1.
{%- enddoc -%}

{%- liquid
  assign product = variant.product
  assign image = variant.featured_image | default: product.featured_image
  assign eligible_count = count | default: 1 | plus: 0

  assign badge = ''
  assign badge_class = ''
  assign status_badge = ''
  if variant.available == false
    assign badge = 'content.product_badge_sold_out' | t
    assign badge_class = 'color-custom-badge-sold-out'
  else
    if variant.compare_at_price > variant.price
      assign badge = 'content.product_badge_sale' | t
      assign badge_class = 'color-custom-badge-sale'
    endif
    if settings.gamma_availability_badges
      capture status
        render 'gamma-availability-status', product: product, variant: variant
      endcapture
      assign status = status | strip
      case status
        when 'backorder'
          assign status_badge = 'gamma_availability.backorder.badge' | t
        when 'special_order'
          assign status_badge = 'gamma_availability.special_order.label' | t
      endcase
    endif
  endif
-%}
<div class="gamma-promotion__variant">
  <div
    class="gamma-promotion__variant-media"
    {% if image != blank %}
      style="--gamma-variant-ratio: {{ image.aspect_ratio | default: 1 }};"
    {% endif %}
  >
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 832
        | image_tag:
          widths: '240, 352, 480, 832',
          sizes: '(min-width: 750px) 260px, 50vw',
          loading: 'lazy',
          alt: '',
          class: 'gamma-promotion__variant-image'
      }}
    {%- endif -%}
    {%- if badge != blank or status_badge != blank -%}
      {%- comment -%} Outside the link, so the status isn't part of the link's name. {%- endcomment -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }} gamma-promotion__variant-badges"
        style="
          --badge-border-radius: {{ settings.badge_corner_radius }}px;
          --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        {%- if badge != blank -%}
          <div class="product-badges__badge product-badges__badge--rectangle {{ badge_class }}">
            {{- badge -}}
          </div>
        {%- endif -%}
        {%- if status_badge != blank -%}
          <div class="product-badges__badge product-badges__badge--rectangle gamma-promotion__status-badge">
            {{- status_badge -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <a class="gamma-promotion__variant-link" href="{{ variant.url }}">{{ product.title | escape }}</a>
  <p class="gamma-promotion__variant-price">
    {%- if variant.compare_at_price > variant.price -%}
      <span class="gamma-promotion__variant-amount">
        <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
        {%- render 'gamma-money', price: variant.price -%}
      </span>
      <span class="gamma-promotion__variant-compare">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
        {%- render 'gamma-money', price: variant.compare_at_price -%}
      </span>
    {%- else -%}
      <span class="gamma-promotion__variant-amount">{%- render 'gamma-money', price: variant.price -%}</span>
    {%- endif -%}
  </p>
  {%- unless product.has_only_default_variant -%}
    <p class="gamma-promotion__variants">
      {{- 'gamma_promotion.cards.eligible_variants' | t: count: eligible_count, variants: names -}}
    </p>
  {%- endunless -%}
</div>

{%- render 'product-badges-styles' -%}

{% stylesheet %}
  /*
    Matches the native product card of the campaign template: a 4px gap, the image at its own ratio
    with square corners, the title as a paragraph with 4px above it and the price in the H6 preset,
    sale price first. Product cards and their image tile are revisited in G26.
  */
  .gamma-promotion__variant {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 4px;
  }

  .gamma-promotion__variant > p {
    margin: 0;
  }

  /* Horizon positions badges from its card's own properties, which this card doesn't have. */
  .gamma-promotion__variant-media {
    --border-radius: 0px;
    --padding-block-start: 0px;
    --padding-inline-start: 0px;
    --padding-inline-end: 0px;

    position: relative;
    overflow: hidden;
    aspect-ratio: var(--gamma-variant-ratio, 1);
    background-color: var(--gamma-color-panel);
  }

  .gamma-promotion__variant-media:has(> .gamma-promotion__variant-image) {
    background-color: transparent;
  }

  .gamma-promotion__variant-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gamma-promotion__variant-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-2xs, 0.3rem);
    max-inline-size: calc(100% - 2 * var(--badge-inset));
    pointer-events: none;
  }

  .gamma-promotion__variant-badges.product-badges--top-right {
    align-items: flex-end;
  }

  /* The outlined status badge of the native card (gamma-availability-badge). */
  .gamma-promotion__status-badge {
    box-shadow: inset 0 0 0 1px currentColor;
    overflow-wrap: anywhere;
  }

  /* The title link covers the card, as the native card's link does. */
  .gamma-promotion__variant-link {
    padding-block-start: 4px;
    color: inherit;
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .gamma-promotion__variant-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .gamma-promotion__variant-link:hover {
    text-decoration: underline;
  }

  .gamma-promotion__variant-link:focus-visible {
    outline: none;
  }

  .gamma-promotion__variant:has(.gamma-promotion__variant-link:focus-visible) {
    outline: var(--focus-outline-width, 2px) solid currentColor;
    outline-offset: var(--focus-outline-offset, 3px);
  }

  .gamma-promotion__variant-price {
    font-family: var(--font-h6--family);
    font-style: var(--font-h6--style);
    font-weight: var(--font-h6--weight);
    font-size: var(--font-h6--size);
    line-height: var(--font-h6--line-height);
    letter-spacing: var(--font-h6--letter-spacing);
    text-transform: var(--font-h6--case);
  }

  .gamma-promotion__variant-amount,
  .gamma-promotion__variant-compare {
    display: inline-block;
    white-space: nowrap;
  }

  /* Horizon's compare-at price (price-styles). */
  .gamma-promotion__variant-compare {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  .gamma-promotion__variants {
    color: var(--gamma-color-muted);
    font-size: var(--font-size--sm);
    overflow-wrap: anywhere;
  }
{% endstylesheet %}
