{%- doc -%}
  Renders one live campaign as a line of a collection's promotion callout: its sponsor badge, its title
  linked to the campaign page and its last day. It hides at the campaign's end on loaded pages.

  @param {object} promotion - The live `promotion` entry.
  @param {number} [end] - Campaign end in Unix seconds (exclusive).
{%- enddoc -%}

{%- capture last_day -%}
  {%- render 'gamma-promotion-dates', end: end, mode: 'last' -%}
{%- endcapture -%}
<li class="gamma-promotion-callout__item"{% if end != blank %} data-gamma-hide-at="{{ end }}"{% endif %}>
  {%- comment -%} One flowing line: the spaces between the badge, the link and the date are kept. {%- endcomment -%}
  {%- render 'gamma-brand-badge', brand: promotion.sponsor.value %}
  <a href="{{ promotion.system.url }}">{{ promotion.title.value | escape }}</a>
  {% if last_day != blank -%}
    <span class="gamma-promotion-callout__date">· {{ 'gamma_promotion.index.until' | t: date: last_day }}</span>
  {%- endif -%}
</li>
