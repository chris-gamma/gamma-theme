{%- doc -%}
  Writes on `:root` the design tokens that come straight from theme settings: Gamma Red and the
  card, media and badge radii. `snippets/stylesheets.liquid` renders it once on every layout. The
  tokens that alias Horizon's variables, the type roles and the shared components are in
  `assets/gamma-branding.css` (development plan, "Visual design language").

  @example
  {% render 'gamma-tokens' %}
{%- enddoc -%}

{% style %}
  :root {
    --gamma-color-accent: {{ settings.color_palette.brand }};
    --gamma-radius-card: {{ settings.card_corner_radius }}px;
    --gamma-radius-media: {{ settings.product_corner_radius }}px;
    --gamma-radius-badge: {{ settings.badge_corner_radius }}px;
  }
{% endstyle %}
