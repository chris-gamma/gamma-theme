{%- doc -%}
  Renders Gamma's notice shell: a neutral panel with an optional icon in Gamma Red, a bold lead-in and
  the message. The `line` variant is the compact inline form for dense lists such as cart lines. The
  shell has no coloured edge, its meaning never depends on colour, and the lead-in is not a heading.
  Callers pass text that is already translated or escaped.

  @param {string} [lead] - Bold lead-in.
  @param {string} [message] - Text that follows the lead-in on the same line.
  @param {string} [content] - Further HTML blocks below the first line (panel only). A paragraph with
    the `gamma-notice__note` class is set as a quieter qualifying line.
  @param {string} [icon] - Icon asset, such as `icon-gamma-gift.svg`.
  @param {string} [variant] - `panel` (default) or `line`.
  @param {string} [hide_at] - Unix seconds at which gamma-hide-at.js hides the notice.

  @example
  {% render 'gamma-notice', icon: 'icon-gamma-gift.svg', lead: lead, message: message %}
{%- enddoc -%}

{%- capture first_line -%}
  {%- if lead != blank -%}<strong>{{ lead }}</strong>{%- endif -%}
  {%- if lead != blank and message != blank -%}{{ ' ' }}{%- endif -%}
  {{- message -}}
{%- endcapture -%}
{%- capture icon_html -%}
  {%- if icon != blank -%}
    <span class="svg-wrapper gamma-notice__icon" aria-hidden="true">
      {{- icon | inline_asset_content -}}
    </span>
  {%- endif -%}
{%- endcapture -%}

{%- if variant == 'line' -%}
  <p
    class="gamma-notice gamma-notice--line gamma-tokens"
    style="{% render 'gamma-tokens' %}"
    {% if hide_at != blank %}
      data-gamma-hide-at="{{ hide_at }}"
    {% endif %}
  >
    {{- icon_html -}}
    <span>{{ first_line }}</span>
  </p>
{%- else -%}
  <div
    class="gamma-notice gamma-tokens"
    style="{% render 'gamma-tokens' %}"
    {% if hide_at != blank %}
      data-gamma-hide-at="{{ hide_at }}"
    {% endif %}
  >
    {{- icon_html -}}
    <div class="gamma-notice__body">
      {%- if first_line != blank -%}
        <p>{{ first_line }}</p>
      {%- endif -%}
      {{- content -}}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Geometry follows the G08 availability notice and cart line, which adopt this shell in G25. */
  .gamma-notice {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-sm, 0.7rem);
    margin: 0;
    padding: var(--padding-md, 0.8rem);
    border-radius: var(--gamma-radius-media);
    background: var(--gamma-color-panel);
    color: var(--color-foreground);
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    overflow-wrap: anywhere;
  }

  .gamma-notice[hidden] {
    display: none;
  }

  .gamma-notice__icon {
    flex-shrink: 0;
    width: var(--icon-size-md, 1.375rem);
    height: var(--icon-size-md, 1.375rem);
    color: var(--gamma-color-accent, currentColor);
  }

  .gamma-notice__icon svg {
    width: 100%;
    height: 100%;
  }

  .gamma-notice__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--gap-xs, 0.5rem);
    min-width: 0;
  }

  .gamma-notice__body > * {
    margin: 0;
  }

  /* A quieter qualifying line inside `content`. */
  .gamma-notice__note {
    color: var(--gamma-color-muted);
    font-size: var(--font-size--sm);
  }

  .gamma-notice code {
    font-family: inherit;
    font-weight: var(--font-weight-bold, 700);
    letter-spacing: 0.05em;
  }

  .gamma-notice--line {
    gap: var(--gap-2xs, 0.3rem);
    margin-block-start: var(--margin-2xs, 0.3rem);
    padding: 0;
    border-radius: 0;
    background: none;
    font-size: var(--font-size--sm);
    line-height: 1.4;
  }

  /*
    A line has no button, so its link is underlined to be found without relying on colour. Horizon's
    cart removes the underline from links in a line's details, so the line itself is set here too.
  */
  .gamma-notice.gamma-notice--line a {
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
  }

  /* The link that follows a line's text: smaller than the text, at the theme's 12px step. */
  .gamma-notice--line .gamma-notice__meta {
    font-size: var(--font-size--2xs);
    white-space: nowrap;
  }

  .gamma-notice--line .gamma-notice__icon {
    width: 1.1em;
    height: 1.1em;
    margin-block-start: 0.15em;
  }
{% endstylesheet %}
