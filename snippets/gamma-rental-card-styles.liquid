{%- doc -%}
  The media and title rules shared by rental equipment cards: the campaign card
  (gamma-rental-card) and the rental search results that gamma-rental-search.js builds. The two
  share these class names, not markup.

  @example
  {% render 'gamma-rental-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /*
    Rental photos follow the product cards beside them: in the search dialog, Horizon's 4:5 crop; on
    campaign pages, each photo's own shape with the product corner radius. Their frame is in
    assets/gamma-branding.css.
  */
  .gamma-rental-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--resource-card-corner-radius, var(--gamma-radius-media));
  }

  .gamma-rental-card__media .gamma-rental-card__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  .resource-card .gamma-rental-card__media {
    --resource-card-aspect-ratio: 4 / 5;
  }

  .resource-card .gamma-rental-card__media .gamma-rental-card__image {
    aspect-ratio: var(--resource-card-aspect-ratio);
    object-fit: cover;
  }

  /* Rental titles often differ only at the end (size, power source), so they aren't clamped. */
  :is(.resource-card, .gamma-rental-card) .gamma-rental-card__title {
    display: block;
    overflow: visible;
  }
{% endstylesheet %}
