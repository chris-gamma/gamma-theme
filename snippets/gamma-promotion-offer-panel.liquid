{%- doc -%}
  Renders a live campaign offer's redemption panel: how the customer receives the benefit. Financial
  wording appears only for a `financial` claim from gamma-promotion-offer, which already requires
  current enforcement verification. Gift panels never say the gift is added to the cart or at checkout.

  @param {object} offer - The `promotion_offer` entry.
  @param {string} claim - The offer's claim class from gamma-promotion-offer (not `none`).
  @param {number} [end] - The offer's effective end in Unix seconds (exclusive).
  @param {string} [contact_url] - The store's contact page URL, for in-store and contact offers.
{%- enddoc -%}

{%- liquid
  assign redemption = offer.redemption.value | append: ''
  assign kind = ''
  case claim
    when 'financial'
      assign kind = redemption
    when 'gift'
      assign kind = 'gift'
    when 'instructions'
      if redemption == 'manufacturer_fulfils'
        assign kind = 'manufacturer'
      elsif redemption == 'in_store' or redemption == 'contact_us'
        assign kind = 'store'
      endif
  endcase
-%}

{%- case kind -%}
  {%- when 'price_shown' -%}
    {%- assign message = 'gamma_promotion.redemption.price_shown' | t -%}
    {%- render 'gamma-notice', message: message -%}
  {%- when 'automatic' -%}
    {%- assign message = 'gamma_promotion.redemption.automatic' | t -%}
    {%- render 'gamma-notice', message: message -%}
  {%- when 'discount_code' -%}
    {%- liquid
      assign code = offer.code.value | strip | escape
      assign message = 'gamma_promotion.redemption.discount_code_html' | t: code: code
    -%}
    {%- render 'gamma-notice', message: message -%}
  {%- when 'gift' -%}
    {%- liquid
      assign availability = offer.gift_availability.value | default: 'guaranteed'
      assign quantity = offer.gift_quantity_limit.value | plus: 0
      assign lead = 'gamma_promotion.gift.heading' | t
    -%}
    {%- capture content -%}
      <p>{{ 'gamma_promotion.gift.how' | t }}</p>
      {%- if offer.gift_supply.value == 'backordered' -%}
        <p>{{ 'gamma_promotion.gift.backordered' | t }}</p>
      {%- endif -%}
      {%- if availability == 'limited' and quantity > 0 -%}
        <p>{{ 'gamma_promotion.gift.limited' | t: count: quantity }}</p>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'gamma-notice', icon: 'icon-gamma-gift.svg', lead: lead, content: content -%}
  {%- when 'manufacturer' -%}
    {%- liquid
      assign action_url = offer.action.value.url | append: ''
      assign action_scheme = action_url | slice: 0, 8 | downcase
      assign action_text = offer.action.value.text | strip
      if action_text == blank
        assign action_text = 'gamma_promotion.redemption.claim_link' | t
      endif
      assign deadline_text = ''
      if end != blank and offer.claim_deadline.value != blank
        assign deadline = offer.claim_deadline.value | date: '%s' | plus: 0
        assign effective_end = end | plus: 0
        if deadline >= effective_end
          capture deadline_text
            render 'gamma-promotion-dates', end: deadline, mode: 'last'
          endcapture
          assign deadline_text = deadline_text | strip
        endif
      endif
      assign lead = 'gamma_promotion.redemption.manufacturer' | t
    -%}
    {%- capture content -%}
      {%- if offer.how_to.value != blank -%}
        <div class="rte">{{ offer.how_to | metafield_tag }}</div>
      {%- endif -%}
      {%- if deadline_text != blank -%}
        <p>{{ 'gamma_promotion.redemption.claim_by' | t: date: deadline_text }}</p>
      {%- endif -%}
      {%- if action_scheme == 'https://' -%}
        <p>
          <a href="{{ action_url | escape }}" target="_blank" rel="noopener">
            {{- action_text | escape -}}
            <span class="visually-hidden">{{ 'gamma_promotion.new_tab' | t }}</span>
          </a>
        </p>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'gamma-notice', lead: lead, content: content -%}
  {%- when 'store' -%}
    {%- assign message = 'gamma_promotion.redemption.in_store' | t -%}
    {%- capture content -%}
      {%- if contact_url != blank -%}
        <p><a href="{{ contact_url }}">{{ 'gamma_promotion.redemption.contact' | t }}</a></p>
      {%- endif -%}
      {%- if offer.how_to.value != blank -%}
        <div class="rte">{{ offer.how_to | metafield_tag }}</div>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'gamma-notice', message: message, content: content -%}
{%- endcase -%}
