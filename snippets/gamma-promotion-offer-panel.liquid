{%- doc -%}
  Renders a live campaign offer's redemption notice: how the customer receives the benefit, with an icon
  for the way it is redeemed. Financial wording appears only for a `financial` claim from
  gamma-promotion-offer, which already requires current enforcement verification. Gift notices never
  say the gift is added to the cart or at checkout; the offer's facts list carries a gift's backorder and
  limited-quantity statements.

  @param {object} offer - The `promotion_offer` entry.
  @param {string} claim - The offer's claim class from gamma-promotion-offer (not `none`).
  @param {number} [end] - The offer's effective end in Unix seconds (exclusive).
  @param {string} [contact_url] - The store's contact page URL, for in-store and contact offers.
  @param {boolean} [current_prices] - Whether the offer shows product cards. In-store and code offers
    then say that the cards' prices are current prices, because neither changes them.
  @param {string} [gift] - The gift named by gamma-promotion-gift, for the gift notice of an offer with
    one group. Offers with several groups name each gift beside its group instead.
{%- enddoc -%}

{%- liquid
  assign redemption = offer.redemption.value | append: ''
  assign kind = ''
  case claim
    when 'financial'
      assign kind = redemption
    when 'gift'
      assign kind = 'gift'
    when 'instructions'
      if redemption == 'manufacturer_fulfils'
        assign kind = 'manufacturer'
      elsif redemption == 'in_store' or redemption == 'contact_us'
        assign kind = 'store'
      endif
  endcase
-%}

{%- case kind -%}
  {%- when 'price_shown' -%}
    {%- assign message = 'gamma_promotion.redemption.price_shown' | t -%}
    {%- render 'gamma-notice', icon: 'icon-discount.svg', message: message -%}
  {%- when 'automatic' -%}
    {%- assign message = 'gamma_promotion.redemption.automatic' | t -%}
    {%- render 'gamma-notice', icon: 'icon-discount.svg', message: message -%}
  {%- when 'discount_code' -%}
    {%- liquid
      assign code = offer.code.value | strip | escape
      assign message = 'gamma_promotion.redemption.discount_code_html' | t: code: code
    -%}
    {%- capture content -%}
      {%- if current_prices -%}
        <p class="gamma-notice__note">{{ 'gamma_promotion.redemption.current_prices_code' | t }}</p>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'gamma-notice', icon: 'icon-discount.svg', message: message, content: content -%}
  {%- when 'gift' -%}
    {%- assign lead = 'gamma_promotion.gift.heading' | t -%}
    {%- capture content -%}
      {{- gift -}}
      <p>{{ 'gamma_promotion.gift.how' | t }}</p>
    {%- endcapture -%}
    {%- render 'gamma-notice', icon: 'icon-gamma-gift.svg', lead: lead, content: content -%}
  {%- when 'manufacturer' -%}
    {%- liquid
      assign action_url = offer.action.value.url | append: ''
      assign action_scheme = action_url | slice: 0, 8 | downcase
      assign action_text = offer.action.value.text | strip
      if action_text == blank
        assign action_text = 'gamma_promotion.redemption.claim_link' | t
      endif
      assign deadline_text = ''
      if end != blank and offer.claim_deadline.value != blank
        assign deadline = offer.claim_deadline.value | date: '%s' | plus: 0
        assign effective_end = end | plus: 0
        if deadline >= effective_end
          capture deadline_text
            render 'gamma-promotion-dates', end: deadline, mode: 'last'
          endcapture
          assign deadline_text = deadline_text | strip
        endif
      endif
      assign lead = 'gamma_promotion.redemption.manufacturer' | t
    -%}
    {%- capture content -%}
      {%- if offer.how_to.value != blank -%}
        <div class="rte">{{ offer.how_to | metafield_tag }}</div>
      {%- endif -%}
      {%- if deadline_text != blank -%}
        <p>{{ 'gamma_promotion.redemption.claim_by' | t: date: deadline_text }}</p>
      {%- endif -%}
      {%- if action_scheme == 'https://' -%}
        <p>
          <a href="{{ action_url | escape }}" target="_blank" rel="noopener">
            {{- action_text | escape -}}
            <span class="visually-hidden">{{ 'gamma_promotion.new_tab' | t }}</span>
          </a>
        </p>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'gamma-notice', icon: 'icon-info.svg', lead: lead, content: content -%}
  {%- when 'store' -%}
    {%- liquid
      if redemption == 'in_store'
        assign lead = 'gamma_promotion.redemption.in_store_lead' | t
        assign message = 'gamma_promotion.redemption.in_store' | t
      else
        assign lead = 'gamma_promotion.redemption.contact_lead' | t
        assign message = 'gamma_promotion.redemption.contact_us' | t
      endif
    -%}
    {%- capture content -%}
      {%- if current_prices and redemption == 'in_store' -%}
        <p class="gamma-notice__note">{{ 'gamma_promotion.redemption.current_prices_in_store' | t }}</p>
      {%- endif -%}
      {%- if offer.how_to.value != blank -%}
        <div class="rte">{{ offer.how_to | metafield_tag }}</div>
      {%- endif -%}
      {%- if contact_url != blank -%}
        <p><a class="button-secondary" href="{{ contact_url }}">{{ 'gamma_promotion.redemption.contact' | t }}</a></p>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'gamma-notice', icon: 'icon-gamma-store.svg', lead: lead, message: message, content: content -%}
{%- endcase -%}
