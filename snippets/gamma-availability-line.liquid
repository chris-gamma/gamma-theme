{%- doc -%}
  Renders Shopify's line status message and backorder/special-order text for one cart line, or no output.
  Uses all cart units of the line's variant so split lines share one stock check. Each message is the
  notice shell's line (`snippets/gamma-notice.liquid`), written here so a cart line adds no render.

  @param {object} item - Cart line item.
{%- enddoc -%}

{%- liquid
  assign status = ''
  if item.variant != blank
    assign units = cart | item_count_for_variant: item.variant.id | at_least: item.quantity
    capture status
      render 'gamma-availability-status', product: item.product, variant: item.variant, quantity: units
    endcapture
    assign status = status | strip
  endif

  assign shown = false
  case status
    when 'backorder'
      assign shown = true
      assign icon = 'icon-gamma-backorder.svg'
      assign label = 'gamma_availability.backorder.label' | t
      assign message = 'gamma_availability.backorder.message' | t
    when 'partial_backorder'
      assign shown = true
      assign icon = 'icon-gamma-backorder.svg'
      assign label = 'gamma_availability.partial_backorder.label' | t
      assign message = 'gamma_availability.partial_backorder.message' | t
    when 'special_order'
      assign shown = true
      assign icon = 'icon-gamma-special-order.svg'
      assign label = 'gamma_availability.special_order.label' | t
      assign message = 'gamma_availability.special_order.message' | t
  endcase
-%}
{%- if item.error_message != blank -%}
  <p class="gamma-notice gamma-notice--line gamma-tokens gamma-availability-line gamma-availability-line--error">
    <span
      class="svg-wrapper gamma-notice__icon"
      aria-hidden="true"
    >
      {{- 'icon-error.svg' | inline_asset_content -}}
    </span>
    <span>{{ item.error_message | escape }}</span>
  </p>
{%- endif -%}
{%- if shown -%}
  <p class="gamma-notice gamma-notice--line gamma-tokens gamma-availability-line gamma-availability-line--{{ status }}">
    <span
      class="svg-wrapper gamma-notice__icon"
      aria-hidden="true"
    >
      {{- icon | inline_asset_content -}}
    </span>
    <span><strong>{{ label }}</strong> {{ message }}</span>
  </p>
{%- endif -%}
