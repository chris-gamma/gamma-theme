{%- doc -%}
  Renders the selected-variant backorder/special-order notice before purchase controls, in the shared
  notice shell. The element and its panel are always present so product selection can update or clear
  the notice.

  @param {object} product - Product owning the purchase form.
  @param {object} variant - Selected or first available variant.
  @param {object} section - Section rendering the purchase form.
  @param {object} block - Buy-buttons block rendering the notice.
{%- enddoc -%}

{%- liquid
  capture status
    render 'gamma-availability-status', product: product, variant: variant
  endcapture
  assign status = status | strip
  assign shown = false
  case status
    when 'backorder'
      assign shown = true
      assign icon = 'icon-gamma-backorder.svg'
      assign label = 'gamma_availability.backorder.label' | t
      assign message = 'gamma_availability.backorder.message' | t
    when 'partial_backorder'
      assign shown = true
      assign icon = 'icon-gamma-backorder.svg'
      assign label = 'gamma_availability.partial_backorder.label' | t
      assign message = 'gamma_availability.partial_backorder.message' | t
    when 'special_order'
      assign shown = true
      assign icon = 'icon-gamma-special-order.svg'
      assign label = 'gamma_availability.special_order.label' | t
      assign message = 'gamma_availability.special_order.message' | t
  endcase
-%}
<script
  src="{{ 'gamma-availability-notice.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<gamma-availability-notice
  class="gamma-availability"
  data-section-id="{{ section.id }}"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product.id }}"
  data-variant-id="{{ variant.id }}"
  data-status="{{ status }}"
>
  <div
    ref="panel"
    class="gamma-availability__notice gamma-availability__notice--{{ status }}"
    {% unless shown %}
      hidden
    {% endunless %}
  >
    {%- if shown -%}
      {%- render 'gamma-notice', icon: icon, lead: label, message: message -%}
    {%- endif -%}
  </div>
  <span
    ref="announcement"
    class="visually-hidden"
    role="status"
  ></span>
</gamma-availability-notice>

{% stylesheet %}
  gamma-availability-notice {
    display: block;
    min-width: 0;
  }

  product-card gamma-availability-notice,
  gamma-availability-notice [hidden] {
    display: none;
  }

  .gamma-availability__notice {
    margin-block-end: var(--gap-sm);
  }
{% endstylesheet %}
