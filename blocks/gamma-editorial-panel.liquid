{%- doc -%}
  Editorial panel: an optional 3:2 image, a label, a heading, a lede and one secondary button. Panels
  placed side by side in a section keep their own height, so a panel without an image isn't stretched
  beside one with an image.
{%- enddoc -%}

{%- liquid
  assign image = block.settings.image
  assign link = block.settings.link
  assign new_tab = block.settings.open_in_new_tab
  # The rental site's address comes from Theme settings, in the storefront's language.
  if block.settings.rental_site
    capture link
      render 'gamma-rental-url', any_toggle: true
    endcapture
    assign link = link | strip
    assign new_tab = true
  endif
-%}
<div
  class="gamma-editorial-panel{% if image == blank %} gamma-editorial-panel--text{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if image != blank -%}
    <div class="gamma-media-tile gamma-editorial-panel__media">
      {{-
        image
        | image_url: width: 1400
        | image_tag:
          widths: '400, 600, 800, 1000, 1200, 1400',
          sizes: '(min-width: 1400px) 680px, (min-width: 750px) calc(50vw - 3rem), calc(100vw - 2rem)',
          loading: 'lazy',
          alt: image.alt
      -}}
    </div>
  {%- endif -%}
  <div class="gamma-editorial-panel__body">
    {%- if block.settings.label != blank -%}
      <p class="gamma-type-label">{{ block.settings.label | escape }}</p>
    {%- endif -%}
    {%- if block.settings.heading != blank -%}
      <h2 class="gamma-type-section gamma-editorial-panel__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if block.settings.text != blank -%}
      <div class="gamma-type-lede gamma-editorial-panel__text">{{ block.settings.text }}</div>
    {%- endif -%}
    {%- if block.settings.button_label != blank and link != blank -%}
      <div class="gamma-actions">
        <a
          class="button-secondary gamma-editorial-panel__action"
          href="{{ link }}"
          {% if new_tab %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {{- block.settings.button_label | escape -}}
          {%- if new_tab -%}
            <span class="visually-hidden"> {{ 'gamma_promotion.new_tab' | t }}</span>
            <span class="gamma-editorial-panel__icon" aria-hidden="true">{{ 'icon-external.svg' | inline_asset_content }}</span>
          {%- endif -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gamma-editorial-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--gamma-radius-card);
    background-color: var(--gamma-color-tile);
    color: var(--color-foreground);
  }

  @media screen and (min-width: 750px) {
    .gamma-editorial-panel {
      flex: 1 1 0;
      align-self: flex-start;
    }
  }

  .gamma-editorial-panel__media {
    border-radius: 0;
  }

  /* Photographs fill the tile; campaign artwork, which is shown whole, doesn't use this block. */
  .gamma-editorial-panel__media > img {
    object-fit: cover;
  }

  .gamma-editorial-panel__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm, 0.75rem);
    padding: var(--gamma-space-inner);
  }

  .gamma-editorial-panel__body > * {
    margin: 0;
  }

  .gamma-editorial-panel__heading {
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .gamma-editorial-panel__text > * {
    margin: 0;
  }

  .gamma-editorial-panel__text > * + * {
    margin-block-start: var(--gap-sm, 0.75rem);
  }

  .gamma-editorial-panel .gamma-actions {
    align-self: stretch;
    padding-block-start: var(--gap-2xs, 0.3rem);
  }

  .gamma-editorial-panel__action {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs, 0.3rem);
  }

  .gamma-editorial-panel__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
  }

  .gamma-editorial-panel__icon svg {
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:gamma_editorial.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:gamma_editorial.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:gamma_editorial.action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label"
    },
    {
      "type": "checkbox",
      "id": "rental_site",
      "label": "t:gamma_editorial.rental_site",
      "info": "t:gamma_editorial.rental_site_info",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "visible_if": "{{ block.settings.rental_site == false }}"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false,
      "visible_if": "{{ block.settings.rental_site == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:gamma_editorial.name",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
