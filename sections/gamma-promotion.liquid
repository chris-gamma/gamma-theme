{%- liquid
  assign entry = metaobject
  assign at = 'now' | date: '%s' | plus: 0

  capture state_result
    render 'gamma-promotion-state', promotion: entry, at: at
  endcapture
  assign state_result = state_result | strip
  assign state_parts = state_result | split: '|'
  assign state = state_parts[0]
  assign campaign_start = state_parts[1]
  assign campaign_end = state_parts[2]
  assign diagnostics = state_parts[3]

  # The index page owns the parent path of every campaign URL (/pages/{index}/{campaign}).
  assign url_parts = entry.system.url | split: '/'
  assign last_part = url_parts | last
  assign index_url = entry.system.url | remove_last: last_part | remove_last: '/'
  if index_url == blank
    assign index_url = routes.root_url
  endif

  assign title = entry.title.value | escape
-%}

<div class="section-background"></div>
<div
  class="section section--page-width gamma-promotion gamma-tokens spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} {% render 'gamma-tokens' %}"
>
  {%- case state -%}
    {%- when 'live' -%}
      {%- liquid
        assign shown_offers = ','
        assign shown_count = 0
        assign first_offer_id = ''
        assign first_hide_at = ''
      -%}
      {%- comment -%}
        Which offers may make a claim now, resolved before the hero, which counts them and links to them.
        Gift offers also need a valid product group. Each shown offer adds its row to the overview.
      {%- endcomment -%}
      {%- capture overview_rows -%}
        {%- for offer in entry.offers.value -%}
          {%- liquid
            # An offer listed twice is shown once, as the lookup does (offer_duplicate).
            assign token = ',' | append: offer.system.id | append: ','
            if shown_offers contains token
              continue
            endif
            capture offer_result
              render 'gamma-promotion-offer', offer: offer, parent: state_result, at: at
            endcapture
            assign offer_parts = offer_result | strip | split: '|'
            assign claim = offer_parts[1]
            if claim == blank or claim == 'none'
              if request.design_mode and offer_parts[5] != blank
                assign diagnostics = diagnostics | append: ',' | append: offer.system.handle | append: ':' | append: offer_parts[5]
              endif
              continue
            endif
            if claim == 'gift'
              assign gift_groups = 0
              for group in offer.groups.value
                capture group_data
                  render 'gamma-promotion-group-data', group: group, claim: claim
                endcapture
                assign group_state = group_data | strip | split: '|' | first
                if group_state == 'valid'
                  assign gift_groups = gift_groups | plus: 1
                endif
              endfor
              if gift_groups == 0
                if request.design_mode
                  assign diagnostics = diagnostics | append: ',' | append: offer.system.handle | append: ':gift_groups_missing'
                endif
                continue
              endif
            endif
            assign shown_offers = shown_offers | append: offer.system.id | append: ','
            assign shown_count = shown_count | plus: 1
            assign offer_id = 'GammaOffer-' | append: section.id | append: '-' | append: offer.system.id
            if first_offer_id == blank
              assign first_offer_id = offer_id
            endif
            # Each row disappears with its offer section, and the hero's count with the first of them.
            assign row_hide_at = offer_parts[4]
            if row_hide_at != blank
              assign hide_seconds = row_hide_at | plus: 0
              if first_hide_at == blank
                assign first_hide_at = hide_seconds
              elsif hide_seconds < first_hide_at
                assign first_hide_at = hide_seconds
              endif
            endif
          -%}
          <li{% if row_hide_at != blank %} data-gamma-hide-at="{{ row_hide_at }}"{% endif %}>
            <a class="gamma-promotion__overview-link" href="#{{ offer_id }}">
              <span class="svg-wrapper gamma-promotion__overview-icon" aria-hidden="true">
                {%- render 'gamma-promotion-icon', benefit: offer.benefit.value -%}
              </span>
              <span class="gamma-promotion__overview-text">
                {%- if offer.label.value != blank -%}
                  <span class="gamma-promotion__overview-label">{{ offer.label.value | escape }}</span>
                {%- endif -%}
                <span class="gamma-promotion__overview-title gamma-type-group">{{ offer.title.value | escape }}</span>
              </span>
              <span class="svg-wrapper gamma-promotion__overview-arrow" aria-hidden="true">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- liquid
        # The hero's button leads to the overview, or to the only offer when there is no overview.
        assign offers_target = first_offer_id
        if shown_count >= 2
          assign offers_target = 'GammaOffers-' | append: section.id
        endif
      -%}

      <div class="gamma-promotion__top">
        <p class="gamma-promotion__back">
          <a href="{{ index_url }}">
            <span class="svg-wrapper gamma-promotion__back-icon" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
            <span>{{ 'gamma_promotion.back' | t }}</span>
          </a>
        </p>
        {%- render 'gamma-promotion-hero',
          promotion: entry,
          start: campaign_start,
          end: campaign_end,
          offers: shown_count,
          offers_target: offers_target,
          count_hide_at: first_hide_at
        -%}
      </div>

      {%- liquid
        assign cards_left = 60
        assign card_cap = section.settings.group_card_limit | plus: 0
        assign contact_url = pages.contact.url
      -%}

      {%- if shown_count >= 2 -%}
        <nav
          class="gamma-promotion__overview"
          id="GammaOffers-{{ section.id }}"
          tabindex="-1"
          aria-labelledby="GammaOffersNav-{{ section.id }}"
          data-gamma-hide-empty
        >
          <h2 id="GammaOffersNav-{{ section.id }}" class="gamma-promotion__overview-heading gamma-type-label">
            {{- 'gamma_promotion.offers_nav' | t -}}
          </h2>
          <ul class="gamma-promotion__overview-list" role="list">
            {{- overview_rows -}}
          </ul>
        </nav>
      {%- endif -%}

      {%- assign rendered_offers = ',' -%}
      {%- for offer in entry.offers.value -%}
        {%- assign token = ',' | append: offer.system.id | append: ',' -%}
        {%- unless shown_offers contains token -%}{%- continue -%}{%- endunless -%}
        {%- if rendered_offers contains token -%}{%- continue -%}{%- endif -%}
        {%- assign rendered_offers = rendered_offers | append: offer.system.id | append: ',' -%}
        {%- liquid
          capture offer_result
            render 'gamma-promotion-offer', offer: offer, parent: state_result, at: at
          endcapture
          assign offer_parts = offer_result | strip | split: '|'
          assign claim = offer_parts[1]
          assign offer_end = offer_parts[3]
          assign hide_at = offer_parts[4]
          assign offer_id = 'GammaOffer-' | append: section.id | append: '-' | append: offer.system.id
        -%}
        <section
          class="gamma-promotion__offer"
          id="{{ offer_id }}"
          tabindex="-1"
          aria-labelledby="{{ offer_id }}-title"
          {% if hide_at != blank %}data-gamma-hide-at="{{ hide_at }}"{% endif %}
        >
          {%- comment -%}
            Groups are resolved before the offer's introduction, which they are printed after: its notice
            says that card prices are current prices only when the offer shows product cards. An offer's
            only group gives its gift to the offer's notice and its conditions to the offer's facts; with
            several groups, each names its own gift and conditions.
          {%- endcomment -%}
          {%- liquid
            assign offer_has_products = false
            assign offer_gift = ''
            assign offer_group_facts = ''
            assign lone_group = false
            if offer.groups.value.size == 1
              assign lone_group = true
            endif
          -%}
          {%- capture groups_html -%}
            {%- for group in offer.groups.value -%}
              {%- liquid
                capture group_data
                  render 'gamma-promotion-group-data', group: group, claim: claim
                endcapture
                assign group_parts = group_data | strip | split: '|'
                assign group_state = group_parts[0]
                if group_state == 'invalid'
                  if request.design_mode
                    assign diagnostics = diagnostics | append: ',' | append: offer.system.handle | append: ':group_' | append: group_parts[6]
                  endif
                  continue
                endif
                assign heading = group.heading.value | strip
                assign rental_items = group.rental_items.value
              -%}
              {%- if group_state == 'none' and rental_items == blank and group.note.value == blank and group.description.value == blank and group.link.value == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- liquid
                # Cards are resolved before the heading: a rental group with no displayable item is omitted,
                # and the number of cards decides whether the group gets the label rail.
                assign cards = ''
                assign overflow = ''
                assign card_count = 0
                assign item_count = 0
                assign see_all = false
                assign group_kind = 'text'
                assign group_gift = ''
                assign group_facts = ''
                if group_state == 'valid'
                  capture group_gift
                    if claim == 'gift'
                      render 'gamma-promotion-gift', group: group
                    endif
                  endcapture
                  capture group_facts
                    render 'gamma-promotion-group-facts', group: group, claim: claim, min_quantity: group_parts[2], companion: group_parts[3], staff: group_parts[5]
                  endcapture
                  if lone_group
                    assign offer_gift = group_gift
                    assign offer_group_facts = group_facts
                    assign group_gift = ''
                    assign group_facts = ''
                  endif
                endif
              -%}
              {%- if group_state == 'valid' -%}
                {%- liquid
                  assign group_kind = 'products'
                  assign collection = group.collection.value
                  assign take = card_cap | at_most: cards_left
                -%}
                {%- if group.variants_only.value == true -%}
                  {%- liquid
                    # One card per product, showing its first listed variant (gamma-card-variant resolves
                    # it inside Horizon's card). A first pass keeps each product's listed variants, in
                    # list order, so the cards can name and link the others.
                    assign listed = group.variants.value
                    assign collection_token = ',' | append: collection.id | append: ','
                    assign listed_map = ''
                    for listed_variant in listed
                      assign listed_map = listed_map | append: '@@P' | append: listed_variant.product.id | append: '@@' | append: listed_variant.url | append: '~~' | append: listed_variant.title
                    endfor
                    assign shown_products = ','
                  -%}
                  {%- capture cards -%}
                    {%- for listed_variant in listed -%}
                      {%- liquid
                        # A listed variant qualifies only while its product is still in the group's collection.
                        assign listed_product = listed_variant.product
                        if listed_product == blank or listed_product.url == blank
                          continue
                        endif
                        assign token = ',' | append: listed_product.id | append: ','
                        if shown_products contains token
                          continue
                        endif
                        assign shown_products = shown_products | append: listed_product.id | append: ','
                        assign product_collections = listed_product.collections | map: 'id' | join: ','
                        assign product_collections = ',' | append: product_collections | append: ','
                        unless product_collections contains collection_token
                          continue
                        endunless
                        assign product_marker = '@@P' | append: listed_product.id | append: '@@'
                        assign product_title = listed_product.title | escape
                        assign product_entries = listed_map | split: product_marker
                        assign names = ''
                        assign others = ''
                        assign name_count = 0
                        for product_entry in product_entries offset: 1
                          assign entry_parts = product_entry | split: '@@' | first | split: '~~'
                          assign entry_name = entry_parts[1] | escape
                          assign names = names | append: ', ' | append: entry_name
                          assign name_count = name_count | plus: 1
                          if name_count > 1
                            assign others = others | append: ', <a href="' | append: entry_parts[0] | append: '">' | append: entry_name | append: '<span class="visually-hidden"> – ' | append: product_title | append: '</span></a>'
                          endif
                        endfor
                        assign names = names | remove_first: ', '
                        assign others = others | remove_first: ', '
                        assign item_count = item_count | plus: 1
                      -%}
                      {%- if take > 0 -%}
                        <li class="gamma-promotion__card">
                          {%- content_for 'block', type: '_product-card', id: 'static-product-card', closest.metaobject.promotion_group: group, gamma_product: listed_product -%}
                          {%- comment -%} Only some of the product's variants qualify: the card shows the first, named here with the others. {%- endcomment -%}
                          {%- if name_count < listed_product.variants_count -%}
                            <p class="gamma-promotion__variants">
                              {{- listed_variant.title | escape -}}
                              {%- if others != blank %} · {{ 'gamma_promotion.cards.also' | t }} {{ others }}{% endif -%}
                            </p>
                          {%- endif -%}
                        </li>
                        {%- liquid
                          assign take = take | minus: 1
                          assign cards_left = cards_left | minus: 1
                          assign card_count = card_count | plus: 1
                        -%}
                      {%- else -%}
                        {%- capture overflow_item -%}<li><a href="{{ listed_variant.url }}">{{ listed_product.title | escape }}</a>{% unless listed_product.has_only_default_variant %} ({{ names }}){% endunless %}</li>{%- endcapture -%}
                        {%- assign overflow = overflow | append: overflow_item -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}
                {%- else -%}
                  {%- if take > 0 -%}
                    {%- capture cards -%}
                      {%- for product in collection.products limit: take -%}
                        <li class="gamma-promotion__card">
                          {%- content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product -%}
                        </li>
                        {%- liquid
                          assign cards_left = cards_left | minus: 1
                          assign card_count = card_count | plus: 1
                        -%}
                      {%- endfor -%}
                    {%- endcapture -%}
                  {%- endif -%}
                  {%- liquid
                    assign item_count = collection.products_count
                    if item_count > card_count
                      assign see_all = true
                    endif
                  -%}
                {%- endif -%}
              {%- elsif rental_items != blank -%}
                {%- assign group_kind = 'rental' -%}
                {%- capture cards -%}
                  {%- for item in rental_items -%}
                    {%- liquid
                      capture item_url
                        render 'gamma-promotion-rental-url', url: item.url.value
                      endcapture
                      assign item_url = item_url | strip
                      if item_url == blank
                        continue
                      endif
                      assign item_title = item.title.value | escape
                      assign item_count = item_count | plus: 1
                    -%}
                    {%- if cards_left > 0 -%}
                      <li class="gamma-promotion__card">
                        {%- render 'gamma-rental-card', url: item_url, title: item.title.value, image: item.image.value, note: item.note.value -%}
                      </li>
                      {%- liquid
                        assign cards_left = cards_left | minus: 1
                        assign card_count = card_count | plus: 1
                      -%}
                    {%- else -%}
                      {%- capture overflow_item -%}<li><a href="{{ item_url | escape }}" target="_blank" rel="noopener">{{ item_title }}<span class="visually-hidden"> {{ 'gamma_promotion.new_tab' | t }}</span></a></li>{%- endcapture -%}
                      {%- assign overflow = overflow | append: overflow_item -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endcapture -%}
                {%- if item_count == 0 -%}
                  {%- continue -%}
                {%- endif -%}
              {%- endif -%}
              {%- liquid
                # From 1200px a group of five or more cards has its label beside the grid; smaller groups
                # stack it above a grid identical to collection pages.
                assign group_class = 'gamma-promotion__group'
                if card_count >= 5
                  assign group_class = group_class | append: ' gamma-promotion__group--rail'
                endif
                if group_kind == 'rental'
                  assign group_class = group_class | append: ' gamma-promotion__group--rental'
                endif
              -%}
              <div class="{{ group_class }}">
                <div class="gamma-promotion__group-label">
                  {%- if item_count > 0 -%}
                    <p class="gamma-promotion__group-count gamma-type-label">
                      {%- if group_kind == 'rental' -%}
                        {{- 'gamma_promotion.cards.rental_count' | t: count: item_count -}}
                      {%- else -%}
                        {{- 'gamma_promotion.cards.product_count' | t: count: item_count -}}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                  {%- if heading != blank -%}
                    <h3 class="gamma-promotion__group-heading gamma-type-group">{{ heading | escape }}</h3>
                  {%- endif -%}
                  {{- group_gift -}}
                  {%- if group_facts != blank -%}
                    <dl class="gamma-promotion__facts">{{ group_facts }}</dl>
                  {%- endif -%}
                  {%- if group.note.value != blank -%}
                    <p class="gamma-promotion__group-note">{{ group.note.value | escape }}</p>
                  {%- endif -%}
                  {%- if group.description.value != blank -%}
                    <div class="rte">{{ group.description | metafield_tag }}</div>
                  {%- endif -%}
                  {%- if see_all -%}
                    <p class="gamma-promotion__more">
                      <a href="{{ collection.url }}">{{ 'gamma_promotion.cards.see_all' | t: count: item_count }}</a>
                    </p>
                  {%- endif -%}
                  {%- liquid
                    assign link_url = group.link.value.url | append: ''
                    assign link_text = group.link.value.text | strip
                  -%}
                  {%- if link_url != blank and link_text != blank -%}
                    <p class="gamma-promotion__more"><a href="{{ link_url | escape }}">{{ link_text | escape }}</a></p>
                  {%- endif -%}
                </div>
                {%- if card_count > 0 and group_kind == 'products' -%}
                  {%- assign offer_has_products = true -%}
                {%- endif -%}
                {%- if card_count > 0 or overflow != blank -%}
                  <div class="gamma-promotion__group-items">
                    {%- if card_count > 0 -%}
                      <ul class="gamma-promotion__cards" role="list">{{ cards }}</ul>
                    {%- endif -%}
                    {%- if overflow != blank -%}
                      <p class="gamma-promotion__more">{{ 'gamma_promotion.cards.more' | t }}</p>
                      <ul class="gamma-promotion__more-list">{{ overflow }}</ul>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endcapture -%}

          {%- liquid
            capture offer_dates
              render 'gamma-promotion-dates', start: offer_parts[2], end: offer_end
            endcapture
            assign gift_limit = offer.gift_quantity_limit.value | plus: 0
            # An offer's own period is a fact only when either end of it differs from the campaign's.
            assign own_period = false
            if offer_parts[2] != campaign_start
              assign own_period = true
            elsif offer_end != campaign_end
              assign own_period = true
            endif
          -%}
          {%- capture offer_facts -%}
            {%- if offer_dates != blank and own_period -%}
              <div class="gamma-promotion__fact">
                <dt>{{ 'gamma_promotion.facts.period' | t }}</dt>
                <dd>{{ offer_dates }}</dd>
              </div>
            {%- endif -%}
            {%- if claim == 'gift' and offer.gift_supply.value == 'backordered' -%}
              <div class="gamma-promotion__fact">
                <dt>{{ 'gamma_promotion.facts.availability' | t }}</dt>
                <dd>{{ 'gamma_promotion.gift.backordered' | t }}</dd>
              </div>
            {%- endif -%}
            {%- if claim == 'gift' and offer.gift_availability.value == 'limited' and gift_limit > 0 -%}
              <div class="gamma-promotion__fact">
                <dt>{{ 'gamma_promotion.facts.quantity' | t }}</dt>
                <dd>{{ 'gamma_promotion.gift.limited' | t: count: gift_limit }}</dd>
              </div>
            {%- endif -%}
            {{- offer_group_facts -}}
          {%- endcapture -%}
          {%- capture offer_aside -%}
            {%- render 'gamma-promotion-offer-panel', offer: offer, claim: claim, end: offer_end, contact_url: contact_url, current_prices: offer_has_products, gift: offer_gift -%}
            {%- if offer.image.value != blank -%}
              {{
                offer.image.value
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 600, 900, 1200',
                  sizes: '(min-width: 990px) 40vw, 100vw',
                  class: 'gamma-promotion__offer-image',
                  loading: 'lazy',
                  alt: offer.image.value.alt
              }}
            {%- endif -%}
          {%- endcapture -%}

          <div class="gamma-promotion__offer-head{% if offer_aside != blank %} gamma-promotion__offer-head--aside{% endif %}">
            <div class="gamma-promotion__offer-text">
              {%- if offer.label.value != blank -%}
                <p class="gamma-promotion__chip">
                  <span class="svg-wrapper gamma-promotion__chip-icon" aria-hidden="true">
                    {%- render 'gamma-promotion-icon', benefit: offer.benefit.value -%}
                  </span>
                  {{- offer.label.value | escape -}}
                </p>
              {%- endif -%}
              <h2 id="{{ offer_id }}-title" class="gamma-promotion__offer-title gamma-type-section">{{ offer.title.value | escape }}</h2>
              {%- if offer.summary.value != blank -%}
                <p class="gamma-promotion__summary gamma-type-reading">{{ offer.summary.value | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if offer.details.value != blank -%}
                <div class="rte">{{ offer.details | metafield_tag }}</div>
              {%- endif -%}
              {%- if offer_facts != blank -%}
                <dl class="gamma-promotion__facts">{{ offer_facts }}</dl>
              {%- endif -%}
            </div>
            {%- if offer_aside != blank -%}
              <div class="gamma-promotion__offer-aside">{{ offer_aside }}</div>
            {%- endif -%}
          </div>

          {{ groups_html }}

          {%- if offer.terms.value != blank -%}
            <div class="gamma-promotion__terms gamma-fine-print rte">
              <h3 class="gamma-promotion__terms-heading gamma-type-label">{{ 'gamma_promotion.offer_terms' | t }}</h3>
              {{ offer.terms | metafield_tag }}
            </div>
          {%- endif -%}
        </section>
      {%- endfor -%}

      {%- capture claims -%}
        {%- for offer in entry.offers.value -%}
          {%- assign token = ',' | append: offer.system.id | append: ',' -%}
          {%- if shown_offers contains token -%}{%- continue -%}{%- endif -%}
          {%- assign claim_id = 'GammaClaim-' | append: section.id | append: '-' | append: offer.system.id -%}
          {%- render 'gamma-promotion-redemption', offer: offer, promotion: entry, at: at, id: claim_id, heading_level: 'h3' -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if claims != blank -%}
        <section class="gamma-promotion__claims" aria-labelledby="GammaClaims-{{ section.id }}">
          <h2 id="GammaClaims-{{ section.id }}" class="gamma-promotion__offer-title gamma-type-section">{{ 'gamma_promotion.post_sale.heading' | t }}</h2>
          {{ claims }}
        </section>
      {%- endif -%}

      {%- if entry.terms.value != blank -%}
        <section class="gamma-promotion__terms gamma-fine-print rte" aria-labelledby="GammaTerms-{{ section.id }}">
          <h2 id="GammaTerms-{{ section.id }}" class="gamma-promotion__terms-heading gamma-type-label">{{ 'gamma_promotion.terms' | t }}</h2>
          {{ entry.terms | metafield_tag }}
        </section>
      {%- endif -%}

      <p class="gamma-promotion__end">
        <a class="button-secondary" href="{{ index_url }}">{{ 'gamma_promotion.all_link' | t }}</a>
      </p>

      {%- if request.design_mode and cards_left == 0 -%}
        <p class="gamma-promotion__diagnostic">{{ 'gamma_promotion.card_limit' | t }}</p>
      {%- endif -%}

    {%- when 'ended' -%}
      <header class="gamma-promotion__state">
        <h1 class="gamma-promotion__title gamma-type-display">{{ title }}</h1>
        <p class="gamma-promotion__notice">
          {{- 'gamma_promotion.ended' | t -}}
          {%- capture date_line -%}
            {%- render 'gamma-promotion-dates', start: campaign_start, end: campaign_end -%}
          {%- endcapture -%}
          {%- if date_line != blank %} {{ date_line }}.{% endif -%}
        </p>
        <p><a href="{{ index_url }}">{{ 'gamma_promotion.index_link' | t }}</a></p>
      </header>

      {%- capture claims -%}
        {%- for offer in entry.offers.value -%}
          {%- assign claim_id = 'GammaClaim-' | append: section.id | append: '-' | append: offer.system.id -%}
          {%- render 'gamma-promotion-redemption', offer: offer, promotion: entry, at: at, id: claim_id, heading_level: 'h3' -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if claims != blank -%}
        <section class="gamma-promotion__claims" aria-labelledby="GammaClaims-{{ section.id }}">
          <h2 id="GammaClaims-{{ section.id }}" class="gamma-promotion__offer-title gamma-type-section">{{ 'gamma_promotion.post_sale.heading' | t }}</h2>
          {{ claims }}
        </section>
      {%- endif -%}
    {%- else -%}
      <header class="gamma-promotion__state">
        <h1 class="gamma-promotion__title gamma-type-display">{{ 'gamma_promotion.unavailable_heading' | t }}</h1>
        <p class="gamma-promotion__notice">{{ 'gamma_promotion.unavailable' | t }}</p>
        <p><a href="{{ index_url }}">{{ 'gamma_promotion.index_link' | t }}</a></p>
      </header>
  {%- endcase -%}

  {%- if request.design_mode and diagnostics != blank -%}
    <p class="gamma-promotion__diagnostic">
      {{- 'gamma_promotion.editor_diagnostics' | t: state: state, codes: diagnostics -}}
    </p>
  {%- endif -%}
</div>

<script src="{{ 'gamma-hide-at.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .gamma-promotion {
    row-gap: var(--gamma-space-section);
    min-width: 0;
  }

  .gamma-promotion [hidden] {
    display: none !important;
  }

  /* Horizon scrolls to anchors smoothly whatever the motion preference; this page's jumps honour it. */
  @media (prefers-reduced-motion: reduce) {
    html:has(.gamma-promotion),
    .page-wrapper:has(.gamma-promotion) {
      scroll-behavior: auto;
    }
  }

  .gamma-promotion__top {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 0.5rem);
    min-width: 0;
  }

  .gamma-promotion__back,
  .gamma-promotion__end {
    margin: 0;
  }

  .gamma-promotion__back a {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs, 0.3rem);
    min-block-size: var(--minimum-touch-target, 44px);
    font-weight: var(--font-weight-bold, 700);
    text-decoration-color: currentcolor;
  }

  .gamma-promotion__back-icon {
    flex: none;
    transform: scaleX(-1);
  }

  /* An overview row or the hero's button moves focus to its target, which is not itself a control. */
  .gamma-promotion__overview:focus,
  .gamma-promotion__offer:focus {
    outline: none;
  }

  .gamma-promotion__hero {
    --gamma-badge-inset: 12px;

    display: grid;
    gap: var(--gamma-space-inner);
    align-items: center;
    padding: var(--gamma-space-inner);
    border-radius: var(--gamma-radius-card);
    background: var(--gamma-color-panel);
  }

  .gamma-promotion__hero .gamma-promotion__rte {
    max-inline-size: var(--gamma-measure-text);
    color: var(--gamma-color-muted);
  }

  /* The artwork comes first until the text sits beside it. */
  .gamma-promotion__hero-media {
    order: -1;
  }

  @media screen and (min-width: 750px) {
    .gamma-promotion__hero {
      --gamma-badge-inset: 16px;
    }

    .gamma-promotion__hero-text {
      padding: var(--gamma-space-inner);
    }
  }

  @media screen and (min-width: 990px) {
    .gamma-promotion__hero--media {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .gamma-promotion__hero-media {
      order: 0;
    }
  }

  .gamma-promotion__hero-text,
  .gamma-promotion__state {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.75rem);
    min-width: 0;
    max-width: 48rem;
  }

  .gamma-promotion__eyebrow {
    margin: 0;
  }

  .gamma-promotion__title,
  .gamma-promotion__summary,
  .gamma-promotion__meta,
  .gamma-promotion__notice {
    margin: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .gamma-promotion__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs, 0.3rem) var(--gap-lg, 1.25rem);
    font-weight: var(--font-weight-bold, 700);
  }

  .gamma-promotion__notice {
    padding-inline-start: var(--padding-xs, 0.5rem);
    border-inline-start: 3px solid var(--gamma-color-accent);
  }

  .gamma-promotion__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-sm, 0.75rem) var(--gap-md, 1rem);
    margin: 0;
  }

  /* The hero's button to the offers is the page's one red button; phones go straight to the overview. */
  .gamma-promotion .gamma-promotion__offers-button {
    display: none;
  }

  .gamma-promotion__source {
    text-decoration-color: currentcolor;
  }

  @media screen and (min-width: 750px) {
    .gamma-promotion .gamma-promotion__offers-button {
      display: grid;
    }
  }

  @media screen and (max-width: 749px) {
    .gamma-promotion__actions--offers-only {
      display: none;
    }

    .gamma-promotion__source,
    .gamma-promotion__more a {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--minimum-touch-target, 44px);
    }

    .gamma-promotion__end .button-secondary {
      width: 100%;
    }
  }

  .gamma-promotion__overview {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.75rem);
    min-width: 0;
    scroll-margin-block-start: var(--header-height, 0);
  }

  .gamma-promotion__overview-heading {
    margin: 0;
    color: var(--gamma-color-muted);
  }

  .gamma-promotion__overview-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-sm, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .gamma-promotion__overview-list {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--gap-md, 1rem);
    }
  }

  .gamma-promotion__overview-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-sm, 0.75rem);
    block-size: 100%;
    min-block-size: 4.5rem;
    padding: var(--padding-sm, 0.75rem) var(--padding-md, 1rem);
    border: var(--style-border-width, 1px) solid var(--gamma-color-rule);
    border-radius: var(--gamma-radius-card);
    text-decoration: none;
  }

  .gamma-promotion__overview-link:hover .gamma-promotion__overview-title {
    text-decoration: underline;
    text-decoration-thickness: 0.075em;
    text-underline-offset: 0.125em;
  }

  .gamma-promotion__overview-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--gamma-color-panel);
  }

  .gamma-promotion__overview-icon svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .gamma-promotion__overview-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .gamma-promotion__overview-label {
    color: var(--gamma-color-muted);
    font-size: var(--font-size--sm);
  }

  /* The group heading's face at its phone size, whatever the width: a row is a link, not a heading. */
  .gamma-promotion__overview-title {
    font-size: 1.25rem;
  }

  .gamma-promotion__overview-arrow {
    flex: none;
    transform: rotate(90deg);
  }

  .gamma-promotion__offer {
    display: flex;
    flex-direction: column;
    gap: var(--gamma-space-group);
    padding-block-start: var(--gamma-space-group);
    border-block-start: var(--style-border-width, 1px) solid var(--gamma-color-rule);
    scroll-margin-block-start: var(--header-height, 0);
  }

  /* The offer's text and facts sit beside its notice once there is room for both. */
  .gamma-promotion__offer-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gamma-space-inner);
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .gamma-promotion__offer-head--aside {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: calc(var(--gamma-space-inner) * 2);
    }
  }

  .gamma-promotion__offer-aside {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.75rem);
    min-width: 0;
  }

  .gamma-promotion__chip {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--gap-2xs, 0.3rem);
    max-inline-size: 100%;
    margin: 0;
    padding: 0.25rem 0.75rem 0.25rem 0.5rem;
    border-radius: var(--gamma-radius-badge);
    background: var(--gamma-color-panel);
    font-size: var(--font-size--sm);
    font-weight: var(--font-weight-bold, 700);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .gamma-promotion__chip-icon {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  .gamma-promotion__chip-icon svg {
    width: 100%;
    height: 100%;
  }

  /* Facts: a label and its statement per row, side by side from 750px in the offer's text column. */
  .gamma-promotion__facts {
    display: grid;
    max-inline-size: var(--gamma-measure-text);
    margin: 0;
    border: var(--style-border-width, 1px) solid var(--gamma-color-rule);
    border-radius: var(--gamma-radius-media);
  }

  .gamma-promotion__fact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.125rem var(--gap-sm, 0.75rem);
    padding: var(--padding-xs, 0.5rem) var(--padding-md, 1rem);
  }

  .gamma-promotion__fact + .gamma-promotion__fact {
    border-block-start: var(--style-border-width, 1px) solid var(--gamma-color-rule);
  }

  .gamma-promotion__fact dt {
    font-weight: var(--font-weight-bold, 700);
  }

  .gamma-promotion__fact dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media screen and (min-width: 750px) {
    .gamma-promotion__offer-text .gamma-promotion__fact {
      grid-template-columns: 8.5rem minmax(0, 1fr);
    }

    .gamma-promotion__offer-text .gamma-promotion__fact dd {
      grid-column: 2;
    }
  }

  .gamma-promotion__offer-text {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.75rem);
    min-width: 0;
    max-width: 48rem;
  }

  .gamma-promotion__offer-title,
  .gamma-promotion__group-heading,
  .gamma-promotion__terms-heading {
    margin: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .gamma-promotion__offer-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--gamma-radius-media);
  }

  .gamma-promotion__group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gamma-space-inner);
    align-items: start;
    min-width: 0;
  }

  /* 1360px of content less the rail and its gap leaves four 256px cards, against 259px on collection pages. */
  @media screen and (min-width: 1200px) {
    .gamma-promotion__group--rail {
      grid-template-columns: var(--gamma-rail-size) minmax(0, 1fr);
    }
  }

  /* Rental groups are told apart by a rule, not by panels. */
  .gamma-promotion__group--rental + .gamma-promotion__group--rental {
    padding-block-start: var(--gamma-space-group);
    border-block-start: var(--style-border-width, 1px) solid var(--gamma-color-rule);
  }

  .gamma-promotion__group-label,
  .gamma-promotion__group-items {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.75rem);
    min-width: 0;
  }

  .gamma-promotion__group-label {
    max-inline-size: var(--gamma-measure-text);
  }

  .gamma-promotion__group-count {
    margin: 0;
    color: var(--gamma-color-muted);
  }

  .gamma-promotion__more-list {
    margin: 0;
    padding-inline-start: 1.25em;
  }

  .gamma-promotion__group-note,
  .gamma-promotion__more {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* The collection grid: its minimum card width and gaps come from the collection template's settings. */
  .gamma-promotion__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gamma-grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .gamma-promotion__cards {
      grid-template-columns: repeat(auto-fill, minmax(var(--gamma-grid-card-min), 1fr));
    }
  }

  .gamma-promotion__card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 0.5rem);
    min-width: 0;
  }

  /* Under a card limited to listed variants: the variant shown, then links to the others. */
  .gamma-promotion__variants {
    margin: 0;
    color: var(--gamma-color-muted);
    font-size: var(--font-size--sm);
    overflow-wrap: anywhere;
  }

  .gamma-promotion__variants a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
  }

  .gamma-promotion__claims,
  .gamma-promotion__claim {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.75rem);
    max-width: 48rem;
  }

  .gamma-promotion__claims {
    padding-block-start: var(--gamma-space-group);
    border-block-start: var(--style-border-width, 1px) solid var(--gamma-color-rule);
  }

  .gamma-promotion__claim > p {
    margin: 0;
  }

  .gamma-promotion__diagnostic {
    margin: 0;
    padding: var(--padding-sm, 0.75rem);
    border: 1px dashed currentColor;
    font-family: monospace;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:gamma_promotion.campaign_name",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:gamma_promotion.campaign_info"
    },
    {
      "type": "range",
      "id": "group_card_limit",
      "label": "t:gamma_promotion.group_card_limit",
      "info": "t:gamma_promotion.group_card_limit_info",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
