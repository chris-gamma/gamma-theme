{%- liquid
  assign at = 'now' | date: '%s' | plus: 0
  assign separator = '@@gamma-promotion@@'
  assign key_separator = '~~gamma-key~~'
  assign entries = ''
  # The campaigns the promotions index lists as live, in its order; a campaign in both groups there
  # appears once here.
  paginate metaobjects.promotion.values by 250
    for promotion in metaobjects.promotion.values
      capture state
        render 'gamma-promotion-state', promotion: promotion, at: at
      endcapture
      assign state = state | strip
      assign parts = state | split: '|'
      if parts[0] != 'live'
        continue
      endif
      assign business = promotion.business.value | append: ''
      unless business == 'equipment_sales' or business == 'equipment_rental' or business == 'sales_and_rental'
        continue
      endunless
      capture key
        render 'gamma-promotion-sort-key', promotion: promotion, state: state
      endcapture
      assign has_artwork = 0
      if promotion.image.value != blank
        assign has_artwork = 1
      endif
      # Cards render after sorting, only for the campaigns shown.
      assign entries = entries | append: separator | append: key | append: key_separator | append: parts[2] | append: key_separator | append: has_artwork | append: key_separator | append: promotion.system.handle | append: key_separator | append: state
    endfor
  endpaginate
-%}

{%- if entries != blank -%}
  {%- liquid
    assign sorted = entries | remove_first: separator | split: separator | sort
    assign limit = section.settings.limit | plus: 0
    assign shown = sorted.size
    if shown > limit
      assign shown = limit
    endif
    assign heading_id = 'GammaPromotionHome-' | append: section.id
    assign slides = ''
    capture items
      for entry in sorted limit: shown
        assign fields = entry | split: key_separator
        assign promotion = metaobjects.promotion[fields[3]]
        capture card
          render 'gamma-promotion-card', promotion: promotion, state: fields[4], heading_level: 'h3'
        endcapture
        assign item_class = 'gamma-promotion-home__item'
        # A single campaign with artwork takes the index's feature card.
        if shown == 1 and fields[2] == '1'
          assign item_class = item_class | append: ' gamma-promotion-feature'
        endif
        echo '<li class="' | append: item_class | append: '" data-gamma-hide-at="' | append: fields[1] | append: '">'
        echo card
        echo '</li>'
        assign slide = '<div class="gamma-promotion-home__slide" data-gamma-hide-at="' | append: fields[1] | append: '">' | append: card | append: '</div>'
        assign slides = slides | append: separator | append: slide
      endfor
    endcapture
    assign slides = slides | remove_first: separator | split: separator
  -%}

  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
  <div class="section-background color-custom-{{ section.id }}"></div>
  <div
    class="section section--{{ section.settings.section_width }} color-custom-{{ section.id }} gamma-promotion-home spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
    data-gamma-hide-empty
  >
    <section class="gamma-promotion-home__content" aria-labelledby="{{ heading_id }}">
      <div class="gamma-section-heading">
        <h2 id="{{ heading_id }}" class="gamma-type-section">{{ 'gamma_promotion.home.heading' | t }}</h2>
        <p class="gamma-section-heading__count">{{ 'gamma_promotion.index.count' | t: count: sorted.size }}</p>
        {%- if section.settings.link != blank -%}
          <a class="gamma-section-heading__link" href="{{ section.settings.link }}">
            {{- 'actions.view_all' | t -}}
            <span class="visually-hidden">: {{ 'gamma_promotion.home.heading' | t }}</span>
            <span class="gamma-section-heading__arrow" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Phones swipe through two or more campaigns in Horizon's carousel; one campaign spans the width. {%- endcomment -%}
      <ul
        class="gamma-promotion-home__grid{% if shown > 1 %} hidden--mobile{% endif %}"
        role="list"
      >
        {{- items -}}
      </ul>
      {%- if shown > 1 -%}
        <div class="gamma-promotion-home__carousel hidden--desktop" style="--mobile-card-size: 82cqw;">
          {% render 'resource-list-carousel',
            ref: 'gammaPromotionHomeCarousel',
            slides: slides,
            slide_count: shown,
            settings: section.settings,
            slide_width_max: '450px'
          %}
        </div>
      {%- endif -%}
    </section>
  </div>
  <script src="{{ 'gamma-hide-at.js' | asset_url }}" type="module" fetchpriority="low"></script>
{%- endif -%}

{% stylesheet %}
  .gamma-promotion-home[hidden],
  .resource-list__slide:has(> .gamma-promotion-home__slide[hidden]) {
    display: none;
  }

  .gamma-promotion-home__content {
    display: flex;
    flex-direction: column;
    gap: var(--gamma-space-inner);
    min-width: 0;
  }

  .gamma-promotion-home__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gamma-space-inner);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gamma-promotion-home__item {
    min-width: 0;
  }

  .gamma-promotion-home__slide {
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .gamma-promotion-home__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gamma-promotion-home__item.gamma-promotion-feature {
      grid-column: span 2;
    }
  }

  @media screen and (min-width: 990px) {
    .gamma-promotion-home__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1200px) {
    .gamma-promotion-home__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:gamma_promotion.home_name",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:gamma_promotion.home_info"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:gamma_promotion.home_limit",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:gamma_promotion.home_link"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        { "value": "arrow", "label": "t:options.arrows" },
        { "value": "chevron", "label": "t:options.chevrons" },
        { "value": "arrows_large", "label": "t:options.arrows_large" },
        { "value": "chevron_large", "label": "t:options.chevron_large" },
        { "value": "none", "label": "t:options.none" }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "circle", "label": "t:options.circle" },
        { "value": "square", "label": "t:options.square" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "t:gamma_promotion.home_name",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
