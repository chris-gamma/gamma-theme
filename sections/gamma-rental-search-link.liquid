{%- liquid
  capture rental_url
    render 'gamma-rental-url', terms: search.terms
  endcapture
  assign rental_url = rental_url | strip

  if search.terms != blank
    assign link_text = 'gamma_rental.search_terms' | t: terms: search.terms
  else
    assign link_text = 'gamma_rental.browse' | t
  endif
-%}

{%- if rental_url != blank or request.design_mode -%}
  <div class="section section--page-width">
    <div
      class="spacing-style gamma-rental-link"
      style="
        --horizontal-alignment: {{ section.settings.alignment }};
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      {%- if rental_url != blank -%}
        <a
          class="button-secondary gamma-rental-link__button"
          href="{{ rental_url | escape }}"
        >
          {{- link_text -}}
        </a>
      {%- else -%}
        <p class="gamma-rental-link__notice">{{ 'gamma_rental.editor_disabled' | t }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .gamma-rental-link {
    display: flex;
    justify-content: var(--horizontal-alignment);
  }

  .gamma-rental-link__button {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .gamma-rental-link__notice {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:gamma_rental.name",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:gamma_rental.link_info"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:gamma_rental.name"
    }
  ]
}
{% endschema %}
